# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DATABASE=SPS-Transportation-Admin
MONGODB_COLLECTION=jotform_submissions
FLIGHT_DETAILS_COLLECTION=flight_details
BOOKINGS_COLLECTION=bookings
VEHICLES_COLLECTION=vehicles
ADMIN_USERS_COLLECTION=admin_users
SARTHI_COLLECTION=sarthi
TEMPLATES_COLLECTION=notification_templates
ASSIGNMENTS_COLLECTION=assignments

# AeroAPI
AERO_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio WhatsApp sender. Sandbox value: whatsapp:+14155238886
# Production: register a real WhatsApp Business sender and put it here as whatsapp:+1XXXXXXXXXX.
# When set, notifications try WhatsApp first and fall back to SMS only if WhatsApp fails.
TWILIO_WHATSAPP_FROM=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SPS Transportation Team

# SMTP (dev fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SPS Transportation Team

# JotForm
JOTFORM_API_KEY=
JOTFORM_FORM_ID=231615575331049
JOTFORM_WEBHOOK_SECRET=

# Server
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=*

# Public-facing app URL used when building tracking links in emails. Defaults to http://localhost:5173.
APP_URL=http://localhost:5173

# Security
WEBHOOK_TIMEOUT_SECONDS=30
MAX_REQUESTS_PER_MINUTE=100
REQUEST_SIZE_LIMIT_MB=10

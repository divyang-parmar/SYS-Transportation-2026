# === Required (no defaults) ===
MONGODB_URI=mongodb://localhost:27017
JOTFORM_API_KEY=
JOTFORM_WEBHOOK_SECRET=

# === MongoDB — defaults shown ===
MONGODB_DATABASE=SPS-Transportation-Admin
MONGODB_COLLECTION=jotform_submissions
FLIGHT_DETAILS_COLLECTION=flight_details
BOOKINGS_COLLECTION=bookings
VEHICLES_COLLECTION=vehicles
ADMIN_USERS_COLLECTION=admin_users
SARTHI_COLLECTION=sarthi
TEMPLATES_COLLECTION=notification_templates
ASSIGNMENTS_COLLECTION=assignments

# === JotForm — defaults shown ===
JOTFORM_FORM_ID=231615575331049

# === FastAPI ===
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=*

# === Security ===
WEBHOOK_TIMEOUT_SECONDS=30
MAX_REQUESTS_PER_MINUTE=100
REQUEST_SIZE_LIMIT_MB=10

# === FlightAware AeroAPI — optional ===
AERO_API_KEY=

# === Google OAuth — optional (login falls back to dev-bypass when empty on frontend) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email — production uses SendGrid REST API ===
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SPS Transportation Team

# === Email — SMTP fallback for local dev ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SPS Transportation Team

# === Twilio SMS — optional ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
